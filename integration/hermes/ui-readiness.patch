+def _read_bridge_writer():
+    """Admit writer via BridgeConfig + VikunjaClient gates before any token/request.
+
+    Reuses C1 §9 loopback origin normalization and TokenRef.load (mode/symlink/parent)
+    so readiness cannot bypass the accepted adapter security boundary (NFR-02/03).
+    """
+    path = os.environ.get("EA010_HERMES_BRIDGE_CONFIG")
+    if not path:
+        return None
+    try:
+        raw = json.loads(Path(path).read_text(encoding="utf-8"))
+    except Exception:
+        return None
+    if not isinstance(raw, dict):
+        return None
+    try:
+        from vikunja_local.api import ApiError, VikunjaClient
+        from vikunja_local.hermes_bridge import BridgeConfig, BridgeError
+        cfg = BridgeConfig.from_mapping(raw)
+        # Origin gate runs inside VikunjaClient.__init__ before token retention.
+        client = VikunjaClient(
+            api_origin=cfg.api_origin,
+            project_id=cfg.project_id,
+            token_ref=cfg.token_ref,
+        )
+        secret = client.token_ref.load()
+    except Exception:
+        # BridgeError/ApiError/OSError/TypeError — fail closed, never probe.
+        return None
+    if not secret:
+        return None
+    return {"api_origin": client.api_origin, "project_id": client.project_id, "token": secret}
