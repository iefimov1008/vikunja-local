+@router.post("/proposals/{proposal_id}/tracker/recover")
+def tracker_recover(proposal_id: str, body: TrackerRecover, request: Request):
+    """C5 0.3: owner-only reconcile for an existing Vikunja accept event (no first PUT)."""
+    def write(service):
+        allowed = _configured_hermes_origin()
+        origin = request.headers.get("origin")
+        if (not allowed or not origin or origin != allowed
+                or request.headers.get("sec-fetch-site") == "cross-site"):
+            raise HTTPException(403, "Изменения доступны только из интерфейса Hermes")
+        recover = getattr(service, "recover_vikunja_outbox", None)
+        if not callable(recover):
+            raise HTTPException(503, "Восстановление передачи недоступно")
+        proposal = recover(
+            event_id=body.event_id,
+            allow_first_http=False,
+            proposal_id=proposal_id,
+        )
+        return {"proposal": proposal}
+    return invoke(request, write, write=True)
