+def _verified_http_origin(value):
+    """Admit absolute http(s) origin only (no path/query/userinfo); fail closed."""
+    if not isinstance(value, str) or not value.strip():
+        return None
+    raw = value.strip()
+    lowered = raw.lower()
+    if "example" in lowered or "changeme" in lowered:
+        return None
+    try:
+        from urllib.parse import urlsplit
+        parts = urlsplit(raw)
+        # Invalid ports raise ValueError on .port access — contain here.
+        port = parts.port
+    except Exception:
+        return None
+    if parts.scheme not in {"http", "https"} or not parts.hostname:
+        return None
+    if parts.username is not None or parts.password is not None:
+        return None
+    if parts.path not in ("", "/") or parts.query or parts.fragment:
+        return None
+    host = parts.hostname
+    if ":" in host and not host.startswith("["):
+        host = f"[{host}]"
+    if port is not None:
+        return f"{parts.scheme}://{host}:{port}"
+    return f"{parts.scheme}://{host}"
+
+
+def _verified_browser_origin(value):
+    """Admit C3 browser origin only (absolute http(s), no path/query/userinfo)."""
+    return _verified_http_origin(value)
+
