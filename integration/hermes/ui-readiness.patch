+def _bounded_timeout_s(value, default=1.5):
+    """Finite positive timeout capped for readiness probes."""
+    try:
+        timeout_s = float(default if value is None else value)
+    except (TypeError, ValueError):
+        return default
+    import math
+    if not math.isfinite(timeout_s) or timeout_s <= 0 or timeout_s > 30:
+        return default
+    return timeout_s
+
