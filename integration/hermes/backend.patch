+        tracker_target=vikunja and/or a non-empty event_id mark Vikunja delivery. Legacy
+        Markdown accepts lack both and stay tracker-less when the outbox row is absent.
+        """
+        if not isinstance(proposal, dict):
+            return None
+        decisions = proposal.get('decisions')
+        if not isinstance(decisions, list):
+            return None
+        for decision in decisions:
+            if not isinstance(decision, dict):
+                continue
+            event_id = decision.get('event_id')
+            if decision.get('tracker_target') == 'vikunja' or (
+                isinstance(event_id, str) and event_id.strip()
+            ):
+                return decision
+        return None
