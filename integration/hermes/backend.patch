+                s = self._inventory(self._state())
+                self._complete_vikunja_accept_commit(s)
+        config_path = os.environ.get('EA010_HERMES_BRIDGE_CONFIG')
+        if not config_path:
+            return []
+        from vikunja_local.hermes_bridge import BridgeConfig, HermesBridge, HermesOutboxStore
+        cfg = BridgeConfig.from_mapping(json.loads(Path(config_path).read_text(encoding='utf-8')))
+        bridge = HermesBridge(cfg, HermesOutboxStore(self._vikunja_outbox_path()))
+        if event_id:
+            return [bridge.recover(event_id)]
+        return bridge.recover_all_outbox()
