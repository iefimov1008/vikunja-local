+    def deliver_vikunja_outbox(self, proposal):
+        """Deliver pending Vikunja outbox for one proposal outside Core lock.
+
+        Configured only when EA010_HERMES_BRIDGE_CONFIG points at a bridge JSON.
+        Snapshot/read/_recover never call this — legacy accepted stay undelivered.
+        """
+        tracker = proposal.get('tracker') if isinstance(proposal, dict) else None
+        if not isinstance(tracker, dict) or not tracker.get('event_id'):
+            return proposal
+        # Linked still runs bridge.deliver for live receipt check (no cached success).
+        # Refuse dispatch until acceptance+outbox commit is durable.
+        if self._vikunja_accept_commit_path().exists():
+            with self._lock():
+                s = self._inventory(self._state())
+                self._complete_vikunja_accept_commit(s)
+            proposal = self._project_tracker(proposal if isinstance(proposal, dict) else {})
+            tracker = proposal.get('tracker') if isinstance(proposal, dict) else None
+            if not isinstance(tracker, dict) or not tracker.get('event_id'):
+                return proposal
+        config_path = os.environ.get('EA010_HERMES_BRIDGE_CONFIG')
+        if not config_path:
+            return proposal
+        from vikunja_local.hermes_bridge import (
+            BridgeConfig,
+            HermesBridge,
+            HermesOutboxStore,
+            tracker_availability_projection,
+        )
+        cfg = BridgeConfig.from_mapping(json.loads(Path(config_path).read_text(encoding='utf-8')))
+        bridge = HermesBridge(cfg, HermesOutboxStore(self._vikunja_outbox_path()))
+        result = bridge.deliver(tracker['event_id'])
+        out = copy.deepcopy(proposal)
+        if result.record is None:
+            # Missing/damaged delivery record: keep historical fields, never healthy cache.
+            historical = dict(tracker)
+            avail = tracker_availability_projection(
+                outcome=result.outcome,
+                details=result.details or {'reason': 'outbox_missing'},
+            )
+            if avail is not None:
+                historical['availability'] = avail
+            out['tracker'] = historical
+            return out
+        # Preserve historical linked fields; project failed live checks for the router.
+        public = result.public_tracker()
+        out['tracker'] = public if public is not None else result.record.tracker(
+            live_outcome=result.outcome,
+            live_details=result.details,
+        ).as_dict()
+        return out
+
+    def recover_vikunja_outbox(self, event_id=None):
