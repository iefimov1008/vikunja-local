+    def _repair_vikunja_acceptance_from_outbox(self, s, proposal_id, digest, title, due, source_version):
+        """Repair Core state when outbox survived but state.json lagged (R1)."""
+        from vikunja_local.hermes_bridge import HermesOutboxStore
+        store = HermesOutboxStore(self._vikunja_outbox_path())
+        existing = self._vikunja_outbox_row(store, proposal_id)
+        if existing is None or existing.payload_digest != digest:
+            raise CoreError('incompatible_accept_payload')
+        p = s['proposals'][proposal_id]
+        if p.get('status') == 'accepted' and any(
+            isinstance(d, dict) and d.get('event_id') == existing.event_id for d in (p.get('decisions') or [])
+        ):
+            return self._project_tracker(p)
+        decision = {
+            'action': 'accept',
+            'at': existing.created_at,
+            'note': '',
+            'source_version': source_version,
+            'task_id': None,
+            'due': due,
+            'tracker_target': 'vikunja',
+            'event_id': existing.event_id,
+        }
+        p['decisions'] = list(p.get('decisions') or [])
+        p['decisions'].append(decision)
+        p.update(status='accepted')
+        p['revision'] = int(p.get('revision') or 0) + 1
+        self._save(s)
+        return self._project_tracker(p)
