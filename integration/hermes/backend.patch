+    def _project_tracker(self, proposal):
+        """Attach optional proposal.tracker from durable Vikunja outbox without dispatch.
+
+        Outbox/dependency failures must not look like a legacy accept (FR-EA010-20/21):
+        when decision history records Vikunja delivery identity, raise a bounded
+        local-state CoreError so the router can report unavailable while Core acceptance
+        remains intact. Tracker-less projection is retained only for true legacy accepts.
+        """
+        identity = self._vikunja_decision_identity(proposal)
+        try:
+            from vikunja_local.hermes_bridge import BridgeError, HermesOutboxStore
+        except Exception as exc:
+            if identity is not None:
+                raise CoreError('local_state_unreadable') from exc
+            return proposal
+        store = HermesOutboxStore(self._vikunja_outbox_path())
+        try:
+            row = store.get_by_proposal(proposal.get('id') if isinstance(proposal, dict) else None)
+        except BridgeError as exc:
+            message = str(exc).lower()
+            if 'outbox_missing' in message:
+                if identity is not None:
+                    raise CoreError('local_state_unreadable') from exc
+                return proposal
+            if 'schema' in message:
+                raise CoreError('local_state_schema_changed') from exc
+            raise CoreError('local_state_unreadable') from exc
+        except (OSError, ValueError, TypeError) as exc:
+            # JSONDecodeError ⊆ ValueError; IO/permission → unreadable ledger.
+            raise CoreError('local_state_unreadable') from exc
+        if row is None:
+            if identity is not None:
+                raise CoreError('local_state_unreadable')
+            return proposal
+        out = copy.deepcopy(proposal)
+        out['tracker'] = row.tracker().as_dict()
+        return out
